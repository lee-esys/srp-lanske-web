rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isReadOnlyCoreCollection(collectionId) {
      return collectionId.matches('^core_.*$');
    }

    function isRegisteredAccount() {
      return request.auth != null
        && (
          request.auth.token.firebase.sign_in_provider != 'anonymous'
          || request.auth.token.firebase.get('identities', {}).size() > 0
        );
    }

    function isAdmin() {
      return isRegisteredAccount()
        && request.auth.token.get('admin', false) == true;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userExternalIdentityIds(uid) {
      return get(/databases/$(database)/documents/users/$(uid))
        .data.get('externalIdentityIds', {});
    }

    function hasActiveSourceMapping(uid, sourceType) {
      return userExists(uid)
        && userExternalIdentityIds(uid).get(sourceType, null) != null;
    }

    function isSupportedExternalIdentity(sourceType, sourceUserId, profileUrl) {
      return sourceType == 'tennisbear'
        && sourceUserId is string
        && sourceUserId.matches('^[0-9]{1,20}$')
        && profileUrl is string
        && profileUrl == 'https://www.tennisbear.net/user/' + sourceUserId + '/info';
    }

    function requestLockId(uid, sourceType) {
      return uid + '_' + sourceType;
    }

    function mappingId(sourceType, sourceUserId) {
      return sourceType + '_' + sourceUserId;
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/externalIdentityLinkRequests/$(requestId);
    }

    function requestLockPath(uid, sourceType) {
      return /databases/$(database)/documents/externalIdentityLinkRequestLocks/$(requestLockId(uid, sourceType));
    }

    function mappingPath(mappingDocumentId) {
      return /databases/$(database)/documents/externalIdentityMappings/$(mappingDocumentId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function auditPath(requestId) {
      return /databases/$(database)/documents/externalIdentityLinkRequestAudits/$(requestId);
    }

    function isValidNewLinkRequest(requestId) {
      let data = request.resource.data;
      let lock = getAfter(requestLockPath(data.lanskeUserId, data.sourceType));
      return isRegisteredAccount()
        && data.keys().hasOnly([
          'schemaVersion',
          'lanskeUserId',
          'sourceType',
          'sourceUserId',
          'mappingId',
          'profileUrl',
          'state',
          'confirmationCodeHash',
          'confirmationCodeExpiresAt',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.lanskeUserId == request.auth.uid
        && userExists(data.lanskeUserId)
        && isSupportedExternalIdentity(
          data.sourceType,
          data.sourceUserId,
          data.profileUrl
        )
        && data.mappingId == mappingId(data.sourceType, data.sourceUserId)
        && data.state == 'pending'
        && data.confirmationCodeHash is string
        && data.confirmationCodeHash.matches('^[0-9a-f]{64}$')
        && data.confirmationCodeExpiresAt is timestamp
        && data.confirmationCodeExpiresAt > request.time
        && data.confirmationCodeExpiresAt <= request.time + duration.value(7, 'd')
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && !exists(mappingPath(data.mappingId))
        && !hasActiveSourceMapping(data.lanskeUserId, data.sourceType)
        && lock != null
        && lock.data.lanskeUserId == data.lanskeUserId
        && lock.data.sourceType == data.sourceType
        && lock.data.requestId == requestId;
    }

    function isUserCancelLinkRequest() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && resource.data.state == 'pending'
        && request.resource.data.state == 'canceled'
        && changed.hasOnly(['state', 'canceledAt', 'updatedAt'])
        && request.resource.data.canceledAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(requestLockPath(
          resource.data.lanskeUserId,
          resource.data.sourceType
        ));
    }

    function isUserSupersedeLinkRequest() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let newRequestId = request.resource.data.supersededByRequestId;
      let newRequest = getAfter(requestPath(newRequestId));
      let lock = getAfter(requestLockPath(
        resource.data.lanskeUserId,
        resource.data.sourceType
      ));
      return isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && resource.data.state == 'pending'
        && request.resource.data.state == 'superseded'
        && newRequestId is string
        && changed.hasOnly(['state', 'supersededByRequestId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && newRequest != null
        && newRequest.data.lanskeUserId == resource.data.lanskeUserId
        && newRequest.data.sourceType == resource.data.sourceType
        && newRequest.data.state == 'pending'
        && lock != null
        && lock.data.requestId == newRequestId;
    }

    function isUserUnlinkRequestHistoryUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let userAfter = getAfter(
        /databases/$(database)/documents/users/$(resource.data.lanskeUserId)
      );
      return isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && resource.data.state == 'approved'
        && resource.data.get('unlinkedAt', null) == null
        && request.resource.data.state == 'approved'
        && changed.hasOnly(['unlinkedAt', 'updatedAt'])
        && request.resource.data.unlinkedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(mappingPath(resource.data.mappingId))
        && userAfter != null
        && userAfter.data.get('externalIdentityIds', {})
          .get(resource.data.sourceType, null) == null;
    }

    function isUserExternalIdentityPointerRemoval() {
      let oldIds = resource.data.get('externalIdentityIds', {});
      let newIds = request.resource.data.get('externalIdentityIds', {});
      let nestedDiff = newIds.diff(oldIds);
      let removedMappingId = oldIds.get('tennisbear', null);
      return isRegisteredAccount()
        && request.auth.uid != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['externalIdentityIds'])
        && nestedDiff.addedKeys().size() == 0
        && nestedDiff.changedKeys().size() == 0
        && nestedDiff.removedKeys().hasOnly(['tennisbear'])
        && nestedDiff.removedKeys().hasAll(['tennisbear'])
        && removedMappingId is string
        && !existsAfter(mappingPath(removedMappingId));
    }

    function isAdminExternalIdentityPointerAddition(uid) {
      let oldIds = resource.data.get('externalIdentityIds', {});
      let newIds = request.resource.data.get('externalIdentityIds', {});
      let nestedDiff = newIds.diff(oldIds);
      let addedMappingId = newIds.get('tennisbear', '__missing__');
      let mappingAfter = getAfter(mappingPath(addedMappingId));
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['externalIdentityIds'])
        && nestedDiff.addedKeys().hasOnly(['tennisbear'])
        && nestedDiff.addedKeys().hasAll(['tennisbear'])
        && nestedDiff.changedKeys().size() == 0
        && nestedDiff.removedKeys().size() == 0
        && addedMappingId is string
        && mappingAfter != null
        && mappingAfter.data.lanskeUserId == uid
        && mappingAfter.data.sourceType == 'tennisbear'
        && mappingAfter.data.approvedAt == request.time
        && mappingAfter.data.createdAt == request.time;
    }

    function isAdminRequestApproval(requestId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let lockPath = requestLockPath(
        resource.data.lanskeUserId,
        resource.data.sourceType
      );
      let lockBefore = get(lockPath);
      let mappingAfter = getAfter(mappingPath(resource.data.mappingId));
      let userAfter = getAfter(userPath(resource.data.lanskeUserId));
      let auditAfter = getAfter(auditPath(requestId));
      return isAdmin()
        && resource.data.state == 'pending'
        && resource.data.confirmationCodeExpiresAt > request.time
        && lockBefore != null
        && lockBefore.data.requestId == requestId
        && request.resource.data.state == 'approved'
        && changed.hasOnly(['state', 'approvedAt', 'updatedAt'])
        && request.resource.data.approvedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(lockPath)
        && mappingAfter != null
        && mappingAfter.data.requestId == requestId
        && mappingAfter.data.lanskeUserId == resource.data.lanskeUserId
        && mappingAfter.data.sourceType == resource.data.sourceType
        && mappingAfter.data.sourceUserId == resource.data.sourceUserId
        && mappingAfter.data.profileUrl == resource.data.profileUrl
        && userAfter != null
        && userAfter.data.get('externalIdentityIds', {})
          .get(resource.data.sourceType, null) == resource.data.mappingId
        && auditAfter != null
        && auditAfter.data.action == 'approved'
        && auditAfter.data.actorUserId == request.auth.uid
        && auditAfter.data.createdAt == request.time;
    }

    function isAdminRequestRejection(requestId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let lockPath = requestLockPath(
        resource.data.lanskeUserId,
        resource.data.sourceType
      );
      let lockBefore = get(lockPath);
      let auditAfter = getAfter(auditPath(requestId));
      return isAdmin()
        && resource.data.state == 'pending'
        && resource.data.confirmationCodeExpiresAt > request.time
        && lockBefore != null
        && lockBefore.data.requestId == requestId
        && request.resource.data.state == 'rejected'
        && changed.hasOnly(['state', 'rejectedAt', 'updatedAt'])
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(lockPath)
        && auditAfter != null
        && auditAfter.data.action == 'rejected'
        && auditAfter.data.actorUserId == request.auth.uid
        && auditAfter.data.createdAt == request.time;
    }

    function isAdminAuditCreate(requestId) {
      let data = request.resource.data;
      let requestAfter = getAfter(requestPath(requestId));
      return isAdmin()
        && data.keys().hasOnly([
          'schemaVersion',
          'requestId',
          'action',
          'actorUserId',
          'createdAt'
        ])
        && data.schemaVersion == 1
        && data.requestId == requestId
        && data.actorUserId == request.auth.uid
        && data.createdAt == request.time
        && requestAfter != null
        && (
          (
            data.action == 'approved'
            && requestAfter.data.state == 'approved'
            && requestAfter.data.approvedAt == request.time
          )
          || (
            data.action == 'rejected'
            && requestAfter.data.state == 'rejected'
            && requestAfter.data.rejectedAt == request.time
          )
        );
    }

    function isAdminMappingCreate(mappingDocumentId) {
      let data = request.resource.data;
      let requestAfter = getAfter(requestPath(data.requestId));
      let userAfter = getAfter(userPath(data.lanskeUserId));
      let auditAfter = getAfter(auditPath(data.requestId));
      return isAdmin()
        && data.keys().hasOnly([
          'schemaVersion',
          'sourceType',
          'sourceUserId',
          'lanskeUserId',
          'profileUrl',
          'approvedAt',
          'requestId',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && mappingDocumentId == mappingId(data.sourceType, data.sourceUserId)
        && isSupportedExternalIdentity(
          data.sourceType,
          data.sourceUserId,
          data.profileUrl
        )
        && data.approvedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && requestAfter != null
        && requestAfter.data.state == 'approved'
        && requestAfter.data.approvedAt == request.time
        && requestAfter.data.mappingId == mappingDocumentId
        && requestAfter.data.lanskeUserId == data.lanskeUserId
        && requestAfter.data.sourceType == data.sourceType
        && requestAfter.data.sourceUserId == data.sourceUserId
        && requestAfter.data.profileUrl == data.profileUrl
        && userAfter != null
        && userAfter.data.get('externalIdentityIds', {})
          .get(data.sourceType, null) == mappingDocumentId
        && auditAfter != null
        && auditAfter.data.action == 'approved'
        && auditAfter.data.actorUserId == request.auth.uid
        && auditAfter.data.createdAt == request.time
        && !existsAfter(requestLockPath(data.lanskeUserId, data.sourceType));
    }

    function isAdminRequestLockDelete() {
      let requestAfter = getAfter(requestPath(resource.data.requestId));
      let auditAfter = getAfter(auditPath(resource.data.requestId));
      return isAdmin()
        && requestAfter != null
        && auditAfter != null
        && auditAfter.data.actorUserId == request.auth.uid
        && auditAfter.data.createdAt == request.time
        && (
          (
            requestAfter.data.state == 'approved'
            && requestAfter.data.approvedAt == request.time
            && auditAfter.data.action == 'approved'
          )
          || (
            requestAfter.data.state == 'rejected'
            && requestAfter.data.rejectedAt == request.time
            && auditAfter.data.action == 'rejected'
          )
        );
    }

    // Registered Lanske account documents. Anonymous Firebase users do not
    // create or read users/{uid} documents. A newly linked anonymous account
    // may still carry anonymous as the token's sign-in provider, so linked
    // identities are also accepted as evidence of a registered account.
    match /users/{uid} {
      allow get: if (isRegisteredAccount() && request.auth.uid == uid)
        || isAdmin();
      allow list: if false;
      allow create: if isRegisteredAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schemaVersion', 'createdAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time;
      allow update: if (
          isRegisteredAccount()
          && request.auth.uid == uid
          && isUserExternalIdentityPointerRemoval()
        )
        || isAdminExternalIdentityPointerAddition(uid);
      allow delete: if false;
    }

    // A deterministic per-user/per-source lock keeps at most one active link
    // request. Users can get only their own supported-source lock, including
    // an absent lock during transaction preflight. Listing is never allowed.
    match /externalIdentityLinkRequestLocks/{lockId} {
      allow get: if (
          isRegisteredAccount()
          && lockId == request.auth.uid + '_tennisbear'
        )
        || isAdmin();
      allow list: if false;

      allow create: if isRegisteredAccount()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'lanskeUserId',
          'sourceType',
          'requestId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.lanskeUserId == request.auth.uid
        && lockId == requestLockId(
          request.resource.data.lanskeUserId,
          request.resource.data.sourceType
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(requestPath(request.resource.data.requestId))
        && getAfter(requestPath(request.resource.data.requestId))
          .data.lanskeUserId == request.resource.data.lanskeUserId
        && getAfter(requestPath(request.resource.data.requestId))
          .data.sourceType == request.resource.data.sourceType
        && getAfter(requestPath(request.resource.data.requestId))
          .data.state == 'pending';

      allow update: if isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['requestId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && existsAfter(requestPath(request.resource.data.requestId))
        && getAfter(requestPath(request.resource.data.requestId))
          .data.lanskeUserId == resource.data.lanskeUserId
        && getAfter(requestPath(request.resource.data.requestId))
          .data.sourceType == resource.data.sourceType
        && getAfter(requestPath(request.resource.data.requestId))
          .data.state == 'pending'
        && getAfter(requestPath(resource.data.requestId))
          .data.state == 'superseded'
        && getAfter(requestPath(resource.data.requestId))
          .data.supersededByRequestId == request.resource.data.requestId;

      allow delete: if (
          isRegisteredAccount()
          && resource.data.lanskeUserId == request.auth.uid
          && getAfter(requestPath(resource.data.requestId)).data.state == 'canceled'
        )
        || isAdminRequestLockDelete();
    }

    // Users can create and read only their own request history. Admin review
    // adds bounded confirmation-code lookup and atomic approval/rejection only.
    match /externalIdentityLinkRequests/{requestId} {
      allow get: if (
          isRegisteredAccount()
          && resource.data.lanskeUserId == request.auth.uid
        )
        || isAdmin();
      allow list: if (
          isRegisteredAccount()
          && resource.data.lanskeUserId == request.auth.uid
        )
        || (isAdmin() && request.query.limit != null && request.query.limit <= 2);
      allow create: if isValidNewLinkRequest(requestId);
      allow update: if isUserCancelLinkRequest()
        || isUserSupersedeLinkRequest()
        || isUserUnlinkRequestHistoryUpdate()
        || isAdminRequestApproval(requestId)
        || isAdminRequestRejection(requestId);
      allow delete: if false;
    }

    // Administrator actor IDs stay outside user-readable request documents.
    // Admins may get one audit document for transaction conflict checks and
    // create only the audit coupled to the same approval/rejection transaction.
    match /externalIdentityLinkRequestAudits/{requestId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdminAuditCreate(requestId);
      allow update, delete: if false;
    }

    // Active mapping documents are the source of truth. A user may get only
    // their own mapping as part of unlink processing; listing is never allowed.
    // Admin mapping creation is accepted only inside the approval transaction.
    match /externalIdentityMappings/{mappingDocumentId} {
      allow get: if (
          isRegisteredAccount()
          && resource.data.lanskeUserId == request.auth.uid
        )
        || isAdmin();
      allow list: if false;
      allow create: if isAdminMappingCreate(mappingDocumentId);
      allow update: if false;
      allow delete: if isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('externalIdentityIds', {})
          .get(resource.data.sourceType, null) == null
        && getAfter(requestPath(resource.data.requestId)).data.state == 'approved'
        && getAfter(requestPath(resource.data.requestId)).data.unlinkedAt == request.time;
    }

    // Public share documents used by doubles schedules.
    match /events/{publicId} {
      allow read, create, update: if true;
      allow delete: if false;

      match /schedule_progress/{generatedScheduleId} {
        allow read, create, update: if true;
        allow delete: if false;

        match /matches/{matchKey} {
          allow read, create, update: if true;
          allow delete: if false;
        }
      }
    }

    // Public share documents used by team schedules, including boccia data.
    match /team_schedules/{shareId} {
      allow read, create, update: if true;
      allow delete: if false;

      match /schedule_progress/{generatedScheduleId} {
        allow read, create, update: if true;
        allow delete: if false;

        match /matches/{matchKey} {
          allow read, create, update: if true;
          allow delete: if false;
        }
      }
    }

    // Existing core-generated data is readable from the client,
    // but client writes are not allowed.
    match /{collectionId}/{documentId} {
      allow read: if isReadOnlyCoreCollection(collectionId);
      allow create, update, delete: if false;
    }

    // Deny any collection or document path that is not explicitly handled above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
