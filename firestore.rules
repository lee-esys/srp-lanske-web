rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isReadOnlyCoreCollection(collectionId) {
      return collectionId.matches('^core_.*$');
    }

    function isRegisteredAccount() {
      return request.auth != null
        && (
          request.auth.token.firebase.sign_in_provider != 'anonymous'
          || request.auth.token.firebase.get('identities', {}).size() > 0
        );
    }

    function isAdmin() {
      return isRegisteredAccount()
        && request.auth.token.get('admin', false) == true;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userExternalIdentityIds(uid) {
      return get(/databases/$(database)/documents/users/$(uid))
        .data.get('externalIdentityIds', {});
    }

    function hasActiveSourceMapping(uid, sourceType) {
      return userExists(uid)
        && userExternalIdentityIds(uid).get(sourceType, null) != null;
    }

    function isSupportedExternalIdentity(sourceType, sourceUserId, profileUrl) {
      return sourceType == 'tennisbear'
        && sourceUserId is string
        && sourceUserId.matches('^[0-9]{1,20}$')
        && profileUrl is string
        && profileUrl == 'https://www.tennisbear.net/user/' + sourceUserId + '/info';
    }

    function requestLockId(uid, sourceType) {
      return uid + '_' + sourceType;
    }

    function mappingId(sourceType, sourceUserId) {
      return sourceType + '_' + sourceUserId;
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/externalIdentityLinkRequests/$(requestId);
    }

    function requestLockPath(uid, sourceType) {
      return /databases/$(database)/documents/externalIdentityLinkRequestLocks/$(requestLockId(uid, sourceType));
    }

    function mappingPath(mappingDocumentId) {
      return /databases/$(database)/documents/externalIdentityMappings/$(mappingDocumentId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function auditPath(requestId) {
      return /databases/$(database)/documents/externalIdentityLinkRequestAudits/$(requestId);
    }

    function isValidNewLinkRequest(requestId) {
      let data = request.resource.data;
      let lock = getAfter(requestLockPath(data.lanskeUserId, data.sourceType));
      return isRegisteredAccount()
        && data.keys().hasOnly([
          'schemaVersion',
          'lanskeUserId',
          'sourceType',
          'sourceUserId',
          'mappingId',
          'profileUrl',
          'state',
          'confirmationCodeHash',
          'confirmationCodeExpiresAt',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.lanskeUserId == request.auth.uid
        && userExists(data.lanskeUserId)
        && isSupportedExternalIdentity(
          data.sourceType,
          data.sourceUserId,
          data.profileUrl
        )
        && data.mappingId == mappingId(data.sourceType, data.sourceUserId)
        && data.state == 'pending'
        && data.confirmationCodeHash is string
        && data.confirmationCodeHash.matches('^[0-9a-f]{64}$')
        && data.confirmationCodeExpiresAt is timestamp
        && data.confirmationCodeExpiresAt > request.time
        && data.confirmationCodeExpiresAt <= request.time + duration.value(7, 'd')
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && !exists(mappingPath(data.mappingId))
        && !hasActiveSourceMapping(data.lanskeUserId, data.sourceType)
        && lock != null
        && lock.data.lanskeUserId == data.lanskeUserId
        && lock.data.sourceType == data.sourceType
        && lock.data.requestId == requestId;
    }

    function isUserCancelLinkRequest() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && resource.data.state == 'pending'
        && request.resource.data.state == 'canceled'
        && changed.hasOnly(['state', 'canceledAt', 'updatedAt'])
        && request.resource.data.canceledAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(requestLockPath(
          resource.data.lanskeUserId,
          resource.data.sourceType
        ));
    }

    function isUserSupersedeLinkRequest() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let newRequestId = request.resource.data.supersededByRequestId;
      let newRequest = getAfter(requestPath(newRequestId));
      let lock = getAfter(requestLockPath(
        resource.data.lanskeUserId,
        resource.data.sourceType
      ));
      return isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && resource.data.state == 'pending'
        && request.resource.data.state == 'superseded'
        && newRequestId is string
        && changed.hasOnly(['state', 'supersededByRequestId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && newRequest != null
        && newRequest.data.lanskeUserId == resource.data.lanskeUserId
        && newRequest.data.sourceType == resource.data.sourceType
        && newRequest.data.state == 'pending'
        && lock != null
        && lock.data.requestId == newRequestId;
    }

    function isUserUnlinkRequestHistoryUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let userAfter = getAfter(
        /databases/$(database)/documents/users/$(resource.data.lanskeUserId)
      );
      return isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && resource.data.state == 'approved'
        && resource.data.get('unlinkedAt', null) == null
        && request.resource.data.state == 'approved'
        && changed.hasOnly(['unlinkedAt', 'updatedAt'])
        && request.resource.data.unlinkedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(mappingPath(resource.data.mappingId))
        && userAfter != null
        && userAfter.data.get('externalIdentityIds', {})
          .get(resource.data.sourceType, null) == null;
    }

    function isUserExternalIdentityPointerRemoval() {
      let oldIds = resource.data.get('externalIdentityIds', {});
      let newIds = request.resource.data.get('externalIdentityIds', {});
      let nestedDiff = newIds.diff(oldIds);
      let removedMappingId = oldIds.get('tennisbear', null);
      return isRegisteredAccount()
        && request.auth.uid != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['externalIdentityIds'])
        && nestedDiff.addedKeys().size() == 0
        && nestedDiff.changedKeys().size() == 0
        && nestedDiff.removedKeys().hasOnly(['tennisbear'])
        && nestedDiff.removedKeys().hasAll(['tennisbear'])
        && removedMappingId is string
        && !existsAfter(mappingPath(removedMappingId));
    }

    function isAdminExternalIdentityPointerAddition(uid) {
      let oldIds = resource.data.get('externalIdentityIds', {});
      let newIds = request.resource.data.get('externalIdentityIds', {});
      let nestedDiff = newIds.diff(oldIds);
      let addedMappingId = newIds.get('tennisbear', '__missing__');
      let mappingAfter = getAfter(mappingPath(addedMappingId));
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['externalIdentityIds'])
        && nestedDiff.addedKeys().hasOnly(['tennisbear'])
        && nestedDiff.addedKeys().hasAll(['tennisbear'])
        && nestedDiff.changedKeys().size() == 0
        && nestedDiff.removedKeys().size() == 0
        && addedMappingId is string
        && mappingAfter != null
        && mappingAfter.data.lanskeUserId == uid
        && mappingAfter.data.sourceType == 'tennisbear'
        && mappingAfter.data.approvedAt == request.time
        && mappingAfter.data.createdAt == request.time;
    }

    function isAdminRequestApproval(requestId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let lockPath = requestLockPath(
        resource.data.lanskeUserId,
        resource.data.sourceType
      );
      let lockBefore = get(lockPath);
      let mappingAfter = getAfter(mappingPath(resource.data.mappingId));
      let userAfter = getAfter(userPath(resource.data.lanskeUserId));
      let auditAfter = getAfter(auditPath(requestId));
      return isAdmin()
        && resource.data.state == 'pending'
        && resource.data.confirmationCodeExpiresAt > request.time
        && lockBefore != null
        && lockBefore.data.requestId == requestId
        && request.resource.data.state == 'approved'
        && changed.hasOnly(['state', 'approvedAt', 'updatedAt'])
        && request.resource.data.approvedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(lockPath)
        && mappingAfter != null
        && mappingAfter.data.requestId == requestId
        && mappingAfter.data.lanskeUserId == resource.data.lanskeUserId
        && mappingAfter.data.sourceType == resource.data.sourceType
        && mappingAfter.data.sourceUserId == resource.data.sourceUserId
        && mappingAfter.data.profileUrl == resource.data.profileUrl
        && userAfter != null
        && userAfter.data.get('externalIdentityIds', {})
          .get(resource.data.sourceType, null) == resource.data.mappingId
        && auditAfter != null
        && auditAfter.data.action == 'approved'
        && auditAfter.data.actorUserId == request.auth.uid
        && auditAfter.data.createdAt == request.time;
    }

    function isAdminRequestRejection(requestId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let lockPath = requestLockPath(
        resource.data.lanskeUserId,
        resource.data.sourceType
      );
      let lockBefore = get(lockPath);
      let auditAfter = getAfter(auditPath(requestId));
      return isAdmin()
        && resource.data.state == 'pending'
        && resource.data.confirmationCodeExpiresAt > request.time
        && lockBefore != null
        && lockBefore.data.requestId == requestId
        && request.resource.data.state == 'rejected'
        && changed.hasOnly(['state', 'rejectedAt', 'updatedAt'])
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !existsAfter(lockPath)
        && auditAfter != null
        && auditAfter.data.action == 'rejected'
        && auditAfter.data.actorUserId == request.auth.uid
        && auditAfter.data.createdAt == request.time;
    }

    function isAdminAuditCreate(requestId) {
      let data = request.resource.data;
      let requestAfter = getAfter(requestPath(requestId));
      return isAdmin()
        && data.keys().hasOnly([
          'schemaVersion',
          'requestId',
          'action',
          'actorUserId',
          'createdAt'
        ])
        && data.schemaVersion == 1
        && data.requestId == requestId
        && data.actorUserId == request.auth.uid
        && data.createdAt == request.time
        && requestAfter != null
        && (
          (
            data.action == 'approved'
            && requestAfter.data.state == 'approved'
            && requestAfter.data.approvedAt == request.time
          )
          || (
            data.action == 'rejected'
            && requestAfter.data.state == 'rejected'
            && requestAfter.data.rejectedAt == request.time
          )
        );
    }

    function isAdminMappingCreate(mappingDocumentId) {
      let data = request.resource.data;
      let requestAfter = getAfter(requestPath(data.requestId));
      let userAfter = getAfter(userPath(data.lanskeUserId));
      let auditAfter = getAfter(auditPath(data.requestId));
      return isAdmin()
        && data.keys().hasOnly([
          'schemaVersion',
          'sourceType',
          'sourceUserId',
          'lanskeUserId',
          'profileUrl',
          'approvedAt',
          'requestId',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && mappingDocumentId == mappingId(data.sourceType, data.sourceUserId)
        && isSupportedExternalIdentity(
          data.sourceType,
          data.sourceUserId,
          data.profileUrl
        )
        && data.approvedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && requestAfter != null
        && requestAfter.data.state == 'approved'
        && requestAfter.data.approvedAt == request.time
        && requestAfter.data.mappingId == mappingDocumentId
        && requestAfter.data.lanskeUserId == data.lanskeUserId
        && requestAfter.data.sourceType == data.sourceType
        && requestAfter.data.sourceUserId == data.sourceUserId
        && requestAfter.data.profileUrl == data.profileUrl
        && userAfter != null
        && userAfter.data.get('externalIdentityIds', {})
          .get(data.sourceType, null) == mappingDocumentId
        && auditAfter != null
        && auditAfter.data.action == 'approved'
        && auditAfter.data.actorUserId == request.auth.uid
        && auditAfter.data.createdAt == request.time
        && !existsAfter(requestLockPath(data.lanskeUserId, data.sourceType));
    }

    function isAdminRequestLockDelete() {
      let requestAfter = getAfter(requestPath(resource.data.requestId));
      let auditAfter = getAfter(auditPath(resource.data.requestId));
      return isAdmin()
        && requestAfter != null
        && auditAfter != null
        && auditAfter.data.actorUserId == request.auth.uid
        && auditAfter.data.createdAt == request.time
        && (
          (
            requestAfter.data.state == 'approved'
            && requestAfter.data.approvedAt == request.time
            && auditAfter.data.action == 'approved'
          )
          || (
            requestAfter.data.state == 'rejected'
            && requestAfter.data.rejectedAt == request.time
            && auditAfter.data.action == 'rejected'
          )
        );
    }

    // Registered Lanske account documents. Anonymous Firebase users do not
    // create or read users/{uid} documents. A newly linked anonymous account
    // may still carry anonymous as the token's sign-in provider, so linked
    // identities are also accepted as evidence of a registered account.
    match /users/{uid} {
      allow get: if (isRegisteredAccount() && request.auth.uid == uid)
        || isAdmin();
      allow list: if false;
      allow create: if isRegisteredAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'createdAt',
          'plan'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('plan', 'free') == 'free';
      allow update: if (
          isRegisteredAccount()
          && request.auth.uid == uid
          && isUserExternalIdentityPointerRemoval()
        )
        || isAdminExternalIdentityPointerAddition(uid);
      allow delete: if false;
    }

    // A deterministic per-user/per-source lock keeps at most one active link
    // request. Users can get only their own supported-source lock, including
    // an absent lock during transaction preflight. Listing is never allowed.
    match /externalIdentityLinkRequestLocks/{lockId} {
      allow get: if (
          isRegisteredAccount()
          && lockId == request.auth.uid + '_tennisbear'
        )
        || isAdmin();
      allow list: if false;

      allow create: if isRegisteredAccount()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'lanskeUserId',
          'sourceType',
          'requestId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.lanskeUserId == request.auth.uid
        && lockId == requestLockId(
          request.resource.data.lanskeUserId,
          request.resource.data.sourceType
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(requestPath(request.resource.data.requestId))
        && getAfter(requestPath(request.resource.data.requestId))
          .data.lanskeUserId == request.resource.data.lanskeUserId
        && getAfter(requestPath(request.resource.data.requestId))
          .data.sourceType == request.resource.data.sourceType
        && getAfter(requestPath(request.resource.data.requestId))
          .data.state == 'pending';

      allow update: if isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['requestId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && existsAfter(requestPath(request.resource.data.requestId))
        && getAfter(requestPath(request.resource.data.requestId))
          .data.lanskeUserId == resource.data.lanskeUserId
        && getAfter(requestPath(request.resource.data.requestId))
          .data.sourceType == resource.data.sourceType
        && getAfter(requestPath(request.resource.data.requestId))
          .data.state == 'pending'
        && getAfter(requestPath(resource.data.requestId))
          .data.state == 'superseded'
        && getAfter(requestPath(resource.data.requestId))
          .data.supersededByRequestId == request.resource.data.requestId;

      allow delete: if (
          isRegisteredAccount()
          && resource.data.lanskeUserId == request.auth.uid
          && getAfter(requestPath(resource.data.requestId)).data.state == 'canceled'
        )
        || isAdminRequestLockDelete();
    }

    // Users can create and read only their own request history. Admin review
    // adds bounded confirmation-code lookup and atomic approval/rejection only.
    match /externalIdentityLinkRequests/{requestId} {
      allow get: if (
          isRegisteredAccount()
          && resource.data.lanskeUserId == request.auth.uid
        )
        || isAdmin();
      allow list: if (
          isRegisteredAccount()
          && resource.data.lanskeUserId == request.auth.uid
        )
        || (isAdmin() && request.query.limit != null && request.query.limit <= 2);
      allow create: if isValidNewLinkRequest(requestId);
      allow update: if isUserCancelLinkRequest()
        || isUserSupersedeLinkRequest()
        || isUserUnlinkRequestHistoryUpdate()
        || isAdminRequestApproval(requestId)
        || isAdminRequestRejection(requestId);
      allow delete: if false;
    }

    // Administrator actor IDs stay outside user-readable request documents.
    // Admins may get one audit document for transaction conflict checks and
    // create only the audit coupled to the same approval/rejection transaction.
    match /externalIdentityLinkRequestAudits/{requestId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdminAuditCreate(requestId);
      allow update, delete: if false;
    }

    // Active mapping documents are the source of truth. A user may get only
    // their own mapping as part of unlink processing; listing is never allowed.
    // Admin mapping creation is accepted only inside the approval transaction.
    match /externalIdentityMappings/{mappingDocumentId} {
      allow get: if (
          isRegisteredAccount()
          && resource.data.lanskeUserId == request.auth.uid
        )
        || isAdmin();
      allow list: if false;
      allow create: if isAdminMappingCreate(mappingDocumentId);
      allow update: if false;
      allow delete: if isRegisteredAccount()
        && resource.data.lanskeUserId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('externalIdentityIds', {})
          .get(resource.data.sourceType, null) == null
        && getAfter(requestPath(resource.data.requestId)).data.state == 'approved'
        && getAfter(requestPath(resource.data.requestId)).data.unlinkedAt == request.time;
    }

    function eventPath(publicId) {
      return /databases/$(database)/documents/events/$(publicId);
    }

    function eventExists(publicId) {
      return exists(eventPath(publicId));
    }

    function ownershipTransferPath(sourceUid) {
      return /databases/$(database)/documents/eventOwnershipTransfers/$(sourceUid);
    }

    function isAnonymousAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.auth.token.firebase.get('identities', {}).size() == 0;
    }

    function isValidOwnershipTransferPending(sourceUid) {
      let data = request.resource.data;
      return isAnonymousAccount()
        && request.auth.uid == sourceUid
        && data.keys().hasAll([
          'schemaVersion',
          'sourceUid',
          'handoffSecret',
          'state',
          'createdAt',
          'expiresAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'sourceUid',
          'handoffSecret',
          'state',
          'createdAt',
          'expiresAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.sourceUid == sourceUid
        && data.handoffSecret is string
        && data.handoffSecret.matches('^[A-Za-z0-9_-]{32,128}$')
        && data.state == 'pending'
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(2, 'd');
    }

    function isSourceOwnershipTransferRefresh(sourceUid) {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.state == 'pending'
        && resource.data.sourceUid == sourceUid
        && isValidOwnershipTransferPending(sourceUid)
        && changed.hasOnly([
          'handoffSecret',
          'createdAt',
          'expiresAt',
          'updatedAt'
        ]);
    }

    function isTargetOwnershipTransferAccept(sourceUid) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isRegisteredAccount()
        && resource.data.state == 'pending'
        && resource.data.sourceUid == sourceUid
        && resource.data.expiresAt > request.time
        && request.auth.uid != sourceUid
        && data.keys().hasAll([
          'schemaVersion',
          'sourceUid',
          'handoffSecret',
          'state',
          'createdAt',
          'expiresAt',
          'updatedAt',
          'targetUid',
          'handoffSecretProof',
          'acceptedAt',
          'acceptedExpiresAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'sourceUid',
          'handoffSecret',
          'state',
          'createdAt',
          'expiresAt',
          'updatedAt',
          'targetUid',
          'handoffSecretProof',
          'acceptedAt',
          'acceptedExpiresAt'
        ])
        && data.schemaVersion == resource.data.schemaVersion
        && data.sourceUid == sourceUid
        && data.handoffSecret == resource.data.handoffSecret
        && data.createdAt == resource.data.createdAt
        && data.expiresAt == resource.data.expiresAt
        && data.state == 'accepted'
        && data.targetUid == request.auth.uid
        && data.handoffSecretProof == resource.data.handoffSecret
        && data.acceptedAt == request.time
        && data.updatedAt == request.time
        && data.acceptedExpiresAt is timestamp
        && data.acceptedExpiresAt > request.time
        && data.acceptedExpiresAt <= request.time + duration.value(2, 'h')
        && changed.hasOnly([
          'state',
          'targetUid',
          'handoffSecretProof',
          'acceptedAt',
          'acceptedExpiresAt',
          'updatedAt'
        ])
        && changed.hasAll([
          'state',
          'targetUid',
          'handoffSecretProof',
          'acceptedAt',
          'acceptedExpiresAt',
          'updatedAt'
        ]);
    }

    function isTargetOwnershipTransferAcceptRefresh(sourceUid) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isRegisteredAccount()
        && (
          resource.data.state == 'accepted'
          || resource.data.state == 'completed'
        )
        && resource.data.sourceUid == sourceUid
        && resource.data.targetUid == request.auth.uid
        && resource.data.handoffSecretProof == resource.data.handoffSecret
        && data.state == 'accepted'
        && data.sourceUid == sourceUid
        && data.targetUid == request.auth.uid
        && data.handoffSecret == resource.data.handoffSecret
        && data.handoffSecretProof == resource.data.handoffSecret
        && data.acceptedAt == request.time
        && data.updatedAt == request.time
        && data.acceptedExpiresAt is timestamp
        && data.acceptedExpiresAt > request.time
        && data.acceptedExpiresAt <= request.time + duration.value(2, 'h')
        && changed.hasOnly([
          'state',
          'acceptedAt',
          'acceptedExpiresAt',
          'updatedAt'
        ]);
    }

    function isTargetOwnershipTransferComplete(sourceUid) {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();
      return isRegisteredAccount()
        && resource.data.state == 'accepted'
        && resource.data.sourceUid == sourceUid
        && resource.data.targetUid == request.auth.uid
        && resource.data.acceptedExpiresAt > request.time
        && request.resource.data.state == 'completed'
        && request.resource.data.sourceUid == sourceUid
        && request.resource.data.targetUid == request.auth.uid
        && request.resource.data.completedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changed.hasOnly(['state', 'completedAt', 'updatedAt'])
        && changed.hasAll(['state', 'completedAt', 'updatedAt']);
    }

    function hasActiveOwnershipTransfer(sourceUid) {
      let transfer = get(ownershipTransferPath(sourceUid));
      return isRegisteredAccount()
        && sourceUid is string
        && sourceUid != ''
        && transfer != null
        && transfer.data.sourceUid == sourceUid
        && transfer.data.targetUid == request.auth.uid
        && transfer.data.handoffSecretProof == transfer.data.handoffSecret
        && transfer.data.acceptedExpiresAt > request.time
        && (
          transfer.data.state == 'accepted'
          || transfer.data.state == 'completed'
        );
    }

    function isOwnershipTransferEventUpdate() {
      let sourceUid = resource.data.event.get('ownerUid', null);
      let rootChanged =
        request.resource.data.diff(resource.data).affectedKeys();
      let eventChanged =
        request.resource.data.event.diff(resource.data.event).affectedKeys();
      return sourceUid is string
        && sourceUid != ''
        && request.auth != null
        && sourceUid != request.auth.uid
        && hasActiveOwnershipTransfer(sourceUid)
        && rootChanged.hasOnly(['event', 'provenance'])
        && eventChanged.hasOnly(['ownerUid', 'revision', 'updatedAt'])
        && request.resource.data.event.ownerUid == request.auth.uid
        && request.resource.data.event.revision
          == resource.data.event.revision + 1
        && isValidUpdatedProvenance();
    }

    function isValidWriteOrigin(origin) {
      return origin is map
        && origin.keys().hasAll([
          'environment',
          'host',
          'firebaseProjectId',
          'appVersion'
        ])
        && origin.keys().hasOnly([
          'environment',
          'host',
          'firebaseProjectId',
          'appVersion'
        ])
        && origin.environment is string
        && origin.host is string
        && origin.firebaseProjectId is string
        && origin.appVersion is string;
    }

    function isValidCreatedProvenance(data) {
      let provenance = data.get('provenance', null);
      return provenance is map
        && provenance.keys().hasAll(['createdFrom', 'lastWrittenFrom'])
        && provenance.keys().hasOnly(['createdFrom', 'lastWrittenFrom'])
        && isValidWriteOrigin(provenance.createdFrom)
        && isValidWriteOrigin(provenance.lastWrittenFrom)
        && provenance.createdFrom == provenance.lastWrittenFrom;
    }

    function isValidUpdatedProvenance() {
      let before = resource.data.get('provenance', {});
      let after = request.resource.data.get('provenance', {});
      return before is map
        && after is map
        && after.keys().hasOnly(['createdFrom', 'lastWrittenFrom'])
        && after.get('createdFrom', null) == before.get('createdFrom', null)
        && isValidWriteOrigin(after.get('lastWrittenFrom', null));
    }

    function isValidEventCreate(publicId) {
      let data = request.resource.data;
      let event = data.event;
      let share = data.share;
      return request.auth != null
        && data.keys().hasAll([
          'schemaVersion',
          'event',
          'players',
          'share',
          'importRecord',
          'revisions',
          'courtSettings',
          'provenance'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'event',
          'players',
          'share',
          'importRecord',
          'revisions',
          'courtSettings',
          'provenance'
        ])
        && data.schemaVersion == 2
        && event is map
        && event.keys().hasOnly([
          'id',
          'publicId',
          'ownerUid',
          'title',
          'memo',
          'eventDate',
          'startTime',
          'endTime',
          'location',
          'courtCount',
          'sourceType',
          'sourceUrl',
          'status',
          'currentGeneratedScheduleId',
          'adoptedGeneratedScheduleId',
          'adoptedAt',
          'visibility',
          'visibleUntilRoundNo',
          'expiresAt',
          'revision',
          'createdAt',
          'updatedAt'
        ])
        && event.id is string
        && event.id != ''
        && event.publicId == publicId
        && event.ownerUid == request.auth.uid
        && event.title is string
        && event.title != ''
        && event.courtCount is int
        && event.courtCount > 0
        && event.status == 'draft'
        && event.revision == 1
        && event.createdAt is string
        && event.updatedAt is string
        && data.players is list
        && data.revisions is map
        && data.revisions.keys().hasAll(['display', 'courtSettings'])
        && data.revisions.keys().hasOnly(['display', 'courtSettings'])
        && data.revisions.display == 1
        && data.revisions.courtSettings == 1
        && data.courtSettings is list
        && share is map
        && share.keys().hasAll(['publicId', 'eventId', 'createdAt', 'updatedAt'])
        && share.keys().hasOnly(['publicId', 'eventId', 'createdAt', 'updatedAt'])
        && share.publicId == publicId
        && share.eventId == event.id
        && isValidCreatedProvenance(data);
    }

    function isEventOwner() {
      return request.auth != null
        && resource.data.event.get('ownerUid', null) == request.auth.uid;
    }

    function isOwnerDisplayUpdate() {
      let rootChanged =
        request.resource.data.diff(resource.data).affectedKeys();
      let eventChanged =
        request.resource.data.event.diff(resource.data.event).affectedKeys();
      let revisionsChanged =
        request.resource.data.revisions.diff(resource.data.revisions)
          .affectedKeys();
      return isEventOwner()
        && rootChanged.hasOnly(['event', 'players', 'revisions', 'provenance'])
        && eventChanged.hasOnly(['title', 'memo', 'revision', 'updatedAt'])
        && request.resource.data.event.title is string
        && request.resource.data.event.title != ''
        && request.resource.data.event.memo is string
        && request.resource.data.event.revision
          == resource.data.event.revision + 1
        && revisionsChanged.hasOnly(['display'])
        && request.resource.data.revisions.display
          == resource.data.revisions.display + 1
        && request.resource.data.revisions.courtSettings
          == resource.data.revisions.courtSettings
        && request.resource.data.players is list
        && resource.data.players is list
        && request.resource.data.players.size() == resource.data.players.size()
        && isValidUpdatedProvenance();
    }

    function isOwnerCourtSettingsUpdate() {
      let rootChanged =
        request.resource.data.diff(resource.data).affectedKeys();
      let eventChanged =
        request.resource.data.event.diff(resource.data.event).affectedKeys();
      let revisionsChanged =
        request.resource.data.revisions.diff(resource.data.revisions)
          .affectedKeys();
      return isEventOwner()
        && rootChanged.hasOnly([
          'event',
          'revisions',
          'courtSettings',
          'provenance'
        ])
        && eventChanged.hasOnly(['revision', 'updatedAt'])
        && request.resource.data.event.revision
          == resource.data.event.revision + 1
        && revisionsChanged.hasOnly(['courtSettings'])
        && request.resource.data.revisions.display
          == resource.data.revisions.display
        && request.resource.data.revisions.courtSettings
          == resource.data.revisions.courtSettings + 1
        && request.resource.data.courtSettings is list
        && resource.data.courtSettings is list
        && request.resource.data.courtSettings.size()
          == resource.data.courtSettings.size()
        && isValidUpdatedProvenance();
    }

    function isValidEventSchemaUpdate() {
      let before = resource.data.get('schemaVersion', 1);
      let after = request.resource.data.get('schemaVersion', 1);
      return after == before || (before < 2 && after == 2);
    }

    function isValidOperationalRevisions() {
      let before = resource.data.get('revisions', null);
      let after = request.resource.data.get('revisions', null);
      return after == before
        || (
          before == null
          && after is map
          && after.keys().hasAll(['display', 'courtSettings'])
          && after.keys().hasOnly(['display', 'courtSettings'])
          && after.display == resource.data.event.revision
          && after.courtSettings == resource.data.event.revision
        );
    }

    function isSharedGenerateUpdate() {
      let rootChanged =
        request.resource.data.diff(resource.data).affectedKeys();
      let eventChanged =
        request.resource.data.event.diff(resource.data.event).affectedKeys();
      return rootChanged.hasOnly([
          'schemaVersion',
          'event',
          'revisions',
          'provenance'
        ])
        && eventChanged.hasOnly([
          'status',
          'currentGeneratedScheduleId',
          'revision',
          'updatedAt'
        ])
        && resource.data.event.status != 'adopted'
        && resource.data.event.get('adoptedGeneratedScheduleId', null) == null
        && request.resource.data.event.status == 'generated'
        && request.resource.data.event.currentGeneratedScheduleId is string
        && request.resource.data.event.currentGeneratedScheduleId != ''
        && request.resource.data.event.revision
          == resource.data.event.revision + 1
        && isValidEventSchemaUpdate()
        && isValidOperationalRevisions()
        && isValidUpdatedProvenance();
    }

    function isSharedAdoptUpdate() {
      let rootChanged =
        request.resource.data.diff(resource.data).affectedKeys();
      let eventChanged =
        request.resource.data.event.diff(resource.data.event).affectedKeys();
      let currentGeneratedScheduleId =
        resource.data.event.get('currentGeneratedScheduleId', null);
      return rootChanged.hasOnly([
          'schemaVersion',
          'event',
          'revisions',
          'provenance'
        ])
        && eventChanged.hasOnly([
          'status',
          'currentGeneratedScheduleId',
          'adoptedGeneratedScheduleId',
          'adoptedAt',
          'revision',
          'updatedAt'
        ])
        && currentGeneratedScheduleId is string
        && currentGeneratedScheduleId != ''
        && resource.data.event.get('adoptedGeneratedScheduleId', null) == null
        && request.resource.data.event.status == 'adopted'
        && request.resource.data.event.currentGeneratedScheduleId
          == currentGeneratedScheduleId
        && request.resource.data.event.adoptedGeneratedScheduleId
          == currentGeneratedScheduleId
        && request.resource.data.event.adoptedAt is string
        && request.resource.data.event.revision
          == resource.data.event.revision + 1
        && isValidEventSchemaUpdate()
        && isValidOperationalRevisions()
        && isValidUpdatedProvenance();
    }

    function hasValidProgressCounts(data) {
      return data.total_match_count is int
        && data.total_match_count > 0
        && data.completed_match_count is int
        && data.completed_match_count >= 0
        && data.in_progress_match_count is int
        && data.in_progress_match_count >= 0
        && data.completed_match_count + data.in_progress_match_count
          <= data.total_match_count;
    }

    function isValidProgressCreate(generatedScheduleId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schema_version',
          'schedule_type',
          'generated_schedule_id',
          'total_match_count',
          'completed_match_count',
          'in_progress_match_count',
          'created_at',
          'updated_at',
          'revision',
          'provenance'
        ])
        && data.keys().hasOnly([
          'schema_version',
          'schedule_type',
          'generated_schedule_id',
          'total_match_count',
          'completed_match_count',
          'in_progress_match_count',
          'created_at',
          'updated_at',
          'revision',
          'provenance'
        ])
        && data.schema_version == 1
        && data.schedule_type == 'doubles'
        && data.generated_schedule_id == generatedScheduleId
        && hasValidProgressCounts(data)
        && data.created_at is string
        && data.updated_at is string
        && data.revision == 1
        && isValidCreatedProvenance(data);
    }

    function isValidProgressUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'completed_match_count',
          'in_progress_match_count',
          'updated_at',
          'revision',
          'provenance'
        ])
        && hasValidProgressCounts(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && isValidUpdatedProvenance();
    }

    function hasValidMatchIdentity(data, generatedScheduleId) {
      return data.schema_version == 1
        && data.schedule_type == 'doubles'
        && data.generated_schedule_id == generatedScheduleId
        && data.round_no is int
        && data.round_no > 0
        && data.court_no is int
        && data.court_no > 0
        && (
          data.get('match_no', null) == null
          || (
            data.match_no is int
            && data.match_no > 0
          )
        );
    }

    function hasValidMatchState(data) {
      return (
          data.status == 'scheduled'
          || data.status == 'in_progress'
          || data.status == 'completed'
        )
        && data.note is string
        && (
          data.get('started_at', null) == null
          || data.started_at is string
        )
        && (
          data.get('finished_at', null) == null
          || data.finished_at is string
        );
    }

    function isValidMatchCreate(generatedScheduleId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schema_version',
          'schedule_type',
          'generated_schedule_id',
          'round_no',
          'court_no',
          'match_no',
          'status',
          'result',
          'note',
          'started_at',
          'finished_at',
          'created_at',
          'updated_at',
          'revision',
          'provenance'
        ])
        && data.keys().hasOnly([
          'schema_version',
          'schedule_type',
          'generated_schedule_id',
          'round_no',
          'court_no',
          'match_no',
          'status',
          'result',
          'note',
          'started_at',
          'finished_at',
          'created_at',
          'updated_at',
          'revision',
          'provenance'
        ])
        && hasValidMatchIdentity(data, generatedScheduleId)
        && hasValidMatchState(data)
        && data.created_at is string
        && data.updated_at is string
        && data.revision == 1
        && isValidCreatedProvenance(data);
    }

    function isValidMatchUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'status',
          'result',
          'note',
          'started_at',
          'finished_at',
          'updated_at',
          'revision',
          'provenance'
        ])
        && hasValidMatchState(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && isValidUpdatedProvenance();
    }

    match /eventOwnershipTransfers/{sourceUid} {
      allow get: if request.auth != null
        && (
          request.auth.uid == sourceUid
          || (
            isRegisteredAccount()
            && resource.data.get('targetUid', null) == request.auth.uid
          )
        );
      allow list: if false;
      allow create: if isValidOwnershipTransferPending(sourceUid);
      allow update: if isSourceOwnershipTransferRefresh(sourceUid)
        || isTargetOwnershipTransferAccept(sourceUid)
        || isTargetOwnershipTransferAcceptRefresh(sourceUid)
        || isTargetOwnershipTransferComplete(sourceUid);
      allow delete: if false;
    }

    // Doubles events remain shareable by known public ID. Collection queries
    // normally belong to the current owner. During an accepted anonymous-owner
    // handoff, the authenticated target may query only the source owner UID.
    match /events/{publicId} {
      allow get: if true;
      allow list: if request.auth != null
        && (
          resource.data.event.ownerUid == request.auth.uid
          || hasActiveOwnershipTransfer(resource.data.event.ownerUid)
        );
      allow create: if isValidEventCreate(publicId);
      allow update: if isOwnerDisplayUpdate()
        || isOwnerCourtSettingsUpdate()
        || isSharedGenerateUpdate()
        || isSharedAdoptUpdate()
        || isOwnershipTransferEventUpdate();
      allow delete: if false;

      match /schedule_progress/{generatedScheduleId} {
        allow read: if eventExists(publicId);
        allow create: if eventExists(publicId)
          && isValidProgressCreate(generatedScheduleId);
        allow update: if eventExists(publicId)
          && isValidProgressUpdate();
        allow delete: if false;

        match /matches/{matchKey} {
          allow read: if eventExists(publicId);
          allow create: if eventExists(publicId)
            && isValidMatchCreate(generatedScheduleId);
          allow update: if eventExists(publicId)
            && isValidMatchUpdate();
          allow delete: if false;
        }
      }
    }

    // Public share documents used by team schedules, including boccia data.
    match /team_schedules/{shareId} {
      allow read, create, update: if true;
      allow delete: if false;

      match /schedule_progress/{generatedScheduleId} {
        allow read, create, update: if true;
        allow delete: if false;

        match /matches/{matchKey} {
          allow read, create, update: if true;
          allow delete: if false;
        }
      }
    }

    // Existing core-generated data is readable from the client,
    // but client writes are not allowed.
    match /{collectionId}/{documentId} {
      allow read: if isReadOnlyCoreCollection(collectionId);
      allow create, update, delete: if false;
    }

    // Deny any collection or document path that is not explicitly handled above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
